a=input("Enter ur password: ")
up=0
lo=0
dg=0
sp=0
if len(a)>7:
    for i in a:
        if i.isupper():
            up+=1
        elif i.islower():
            lo+=1
        elif i.isdigit():
            dg+=1
        else:
            sp+=1
    if up>=1 and lo>=1 and dg>=1 and sp>=1:
        print("STRONG password")
    else:
        print("WEAK password")
else:
    print("Weak due to less characters")
