def square():
    s=int(input("Enter side: "))
    print("Area: ",s*s)
def rectangle(a,b):
    print("Area: ",a*b)
def circle():
    r=int(input("Enter radius: "))
    return 3.14*r*r
def triangle(b,h):
    return 0.5*b*h

while True:
    print("1.square")
    print("2.rectangle")
    print("3.circle")
    print("4.triangle")
    print("5.exit")
    ch=int(input("Enter ur choice: "))
    if ch==1:
        square()
    elif ch==2:
        le=int(input("Enter len: "))
        br=int(input("Enter breadth: "))
        rectangle(le,br)
    elif ch==3:
        x=circle()
        print("AREA: ",x)
    elif ch==4:
        b=int(input("Enter base: "))
        h=int(input("Enter height: "))
        y=triangle(b,h)
        print("AREA: ",y)
    else:
        break
